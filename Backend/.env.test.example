# Optional overrides for the test database (loaded by tests/jest.setup-env.js).
# Copy this file to .env.test to use it - .env.test is gitignored and must
# never contain real credentials. Everything not listed here falls back to
# the values in .env (same DB_HOST/DB_USER/DB_PASSWORD, only DB_NAME differs).
#
# One-time setup: createdb trufinity_test
#
# DB_NAME must end in "_test" - src/config/env.ts refuses to start with
# NODE_ENV=test otherwise.
DB_NAME=trufinity_test
