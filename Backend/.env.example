PORT=3000
NODE_ENV=development

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=trufinity

# ServiceTitan Configuration
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_TENANT_ID=2088992281
SERVICETITAN_APP_KEY=
SERVICETITAN_BASE_URL=
SERVICETITAN_AUTH_URL=
# ServiceTitan web app URL used by the Integrations page "Open ServiceTitan" button.
SERVICETITAN_CONNECT_URL=https://go.servicetitan.com


# QuickBooks Online Configuration
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_AUTH_URL=
QBO_TOKEN_URL=
QBO_REVOKE_URL=https://developer.api.intuit.com/v2/oauth2/tokens/revoke
# Set a randomly generated secret of at least 32 bytes on the server.
QBO_DISCONNECT_AUTH_TOKEN=
QBO_API_BASE_URL=
QBO_CDC_POLL_INTERVAL_MS=900000


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_CLOUD_PROJECT_ID=trufinity-email-integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=trufinity-gmail-integration@trufinity-email-integration.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ADMIN_DELEGATED_USER=
GOOGLE_GMAIL_DELEGATED_USER=service@trufinity.ca

# Lace AI - batch export via S3 (no public API; see doc/SPEC-BI-001 Section 4.1)
# Bucket/region/keys are provided by Lace (or provisioned by TruFinity, TBD - confirm
# in writing with Lace who owns the bucket). Files land flat in the bucket root
# (no subfolders); prefixes below filter by filename prefix, not folder path.
# Agent Performance prefix is unconfirmed - no such file has landed in the bucket yet.
LACE_S3_BUCKET=
LACE_S3_REGION=
LACE_S3_ACCESS_KEY_ID=
LACE_S3_SECRET_ACCESS_KEY=
LACE_S3_CALL_ANALYSIS_PREFIX=report_Lace_CcCallAnalysisExport
LACE_S3_AGENT_PERFORMANCE_PREFIX=
# Cron expressions for automated syncing (server time).
LACE_CALL_ANALYSIS_CRON=0 2 * * *
LACE_AGENT_PERFORMANCE_CRON=0 3 1 * *

# ServiceTitan automated sync schedule (server time). Previously ingestion
# only ran from dev-only routes or a manual trigger - nothing synced on its
# own in production.
SERVICETITAN_SYNC_CRON=0 1 * * *
SERVICETITAN_BUSINESS_UNIT_SYNC_CRON=30 1 * * 0
SERVICETITAN_STUCK_RUN_REAPER_CRON=*/30 * * * *
SERVICETITAN_STUCK_RUN_THRESHOLD_MINUTES=60

# Detect layer thresholds (defaults below; SPEC-BI-001 exact values TBD).
DETECT_D01_BOOKING_RATE_DROP_THRESHOLD_POINTS=10
DETECT_D06_OBJECTION_SPIKE_MULTIPLIER=2
DETECT_D06_OBJECTION_MIN_SAMPLE=3
DETECT_F04_AR_OVERDUE_RATE_INCREASE_THRESHOLD_POINTS=10
DETECT_F04_AR_MIN_SAMPLE=5
DETECT_F03_DISCOUNT_RATE_INCREASE_THRESHOLD_POINTS=5
DETECT_F03_DISCOUNT_MIN_SAMPLE=5
DETECT_F04C_AR_CONCENTRATION_THRESHOLD_POINTS=25
DETECT_F04C_AR_MIN_OUTSTANDING=1000
DETECT_F04D_CREDITMEMO_SPIKE_MULTIPLIER=2
DETECT_F04D_CREDITMEMO_MIN_SAMPLE=3
DETECT_F05_REVENUE_GAP_THRESHOLD_POINTS=10
DETECT_F05_MIN_REVENUE=1000

# Narrate layer - writes prose for detected_alerts findings only, never
# recomputes numbers (SPEC-BI-001 Section 4.1).
ANTHROPIC_API_KEY=
NARRATE_MODEL=claude-opus-5

GOOGLE_GMAIL_HISTORICAL_DAYS=365
GOOGLE_GMAIL_SYNC_INTERVAL_MS=900000
GOOGLE_GMAIL_APPROVED_CONTENT_MAILBOXES=service@trufinity.ca,support@trufinity.ca,billing@trufinity.ca

# Authentication
# Public URL of the frontend; used to build password reset links.
APP_BASE_URL=http://localhost:3001
AUTH_SESSION_TTL_HOURS=12
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Reverse-proxy hops to trust for client IPs (set to 1 when behind the frontend/load balancer).
TRUST_PROXY=0

# SMTP for password reset emails. When unset in development, reset links are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TruFinity <no-reply@trufinity.ca>
WORK_ITEM_NOTIFICATION_RECIPIENT=

# Layer B classifier foundation (disabled until provider/model/threshold are approved)
GMAIL_CLASSIFIER_ENABLED=false
GMAIL_CLASSIFIER_PROVIDER=anthropic
GMAIL_CLASSIFIER_MODEL=
GMAIL_CLASSIFIER_CONFIDENCE_THRESHOLD=
GMAIL_CLASSIFIER_TIMEOUT_MS=10000
GMAIL_CLASSIFIER_MAX_RETRIES=2
GMAIL_CLASSIFIER_PROMPT_VERSION=v1
